.github
.idea
.vscode
node_modules
**/node_modules
.next
**/.next
target
**/target
__pycache__
**/__pycache__
.pytest_cache
.ruff_cache
.mypy_cache
.venv
venv
.env
.env.*
!.env.example
logs
tmp
.local-data
*.pem
*.key
*.p12
*.jks
