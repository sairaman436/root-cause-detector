# Purpose: Defines editor-neutral formatting rules for the production monorepo.
# Why it exists: Keeps Java, TypeScript, Python, YAML, Markdown, and IaC files consistent before service implementation begins.
# Architecture fit: Supports the approved engineering foundation by making formatting deterministic across backend, frontend, AI, data, and infrastructure teams.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,kt}]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

