<!--
Purpose: Defines the shared Java library module.
Why it exists: Provides a controlled location for stable Java contracts and infrastructure helpers used by backend modules.
Architecture fit: Supports shared-library governance while preventing business logic from leaking across module boundaries.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.airural</groupId>
        <artifactId>ai-rural-root-cause-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>java-shared</artifactId>
    <name>Java Shared Library</name>
    <description>Shared Java contracts and utilities; intentionally empty of business implementation in Milestone 1.</description>
</project>

