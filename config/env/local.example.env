# Purpose: Documents local environment variables for developers.
# Why it exists: Provides non-secret defaults for Docker Compose and local service configuration.
# Architecture fit: Supports environment-driven configuration without committing real secrets.
SPRING_PROFILES_ACTIVE=local
APP_ENV=local
CORE_BACKEND_PORT=8080
WEB_PORTAL_PORT=3000
ADMIN_PORTAL_PORT=3001
AI_INFERENCE_SERVICE_PORT=8101
RAG_SERVICE_PORT=8102
AGENT_ORCHESTRATOR_PORT=8103
REPORTING_SERVICE_PORT=8104
NOTIFICATION_SERVICE_PORT=8105
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airural
POSTGRES_USER=airural
POSTGRES_PASSWORD=airural_local_only
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=airural
OBJECT_STORAGE_SECRET_KEY=airural_local_only
CORE_BACKEND_URL=http://core-backend:8080
AI_INFERENCE_SERVICE_URL=http://ai-inference-service:8101
RAG_SERVICE_URL=http://rag-service:8102
AGENT_ORCHESTRATOR_URL=http://agent-orchestrator:8103
REPORTING_SERVICE_URL=http://reporting-service:8104
NOTIFICATION_SERVICE_URL=http://notification-service:8105
JWT_ISSUER=airural-platform
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_SIGNING_SECRET=local-development-secret-must-be-rotated-before-production-32-bytes-minimum
