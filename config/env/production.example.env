# Purpose: Documents production configuration keys without storing production values.
# Why it exists: Gives SRE and platform teams a reviewed environment contract for future deployments.
# Architecture fit: Supports Kubernetes, managed secrets, and environment-specific configuration overlays.
SPRING_PROFILES_ACTIVE=prod
APP_ENV=production
CORE_BACKEND_PORT=8080
WEB_PORTAL_PORT=3000
ADMIN_PORTAL_PORT=3001
AI_INFERENCE_SERVICE_PORT=8101
RAG_SERVICE_PORT=8102
AGENT_ORCHESTRATOR_PORT=8103
REPORTING_SERVICE_PORT=8104
NOTIFICATION_SERVICE_PORT=8105
POSTGRES_HOST=__FROM_SECRET_OR_PLATFORM_CONFIG__
POSTGRES_PORT=5432
POSTGRES_DB=__FROM_SECRET_OR_PLATFORM_CONFIG__
POSTGRES_USER=__FROM_SECRET__
POSTGRES_PASSWORD=__FROM_SECRET__
REDIS_HOST=__FROM_PLATFORM_CONFIG__
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=__FROM_PLATFORM_CONFIG__
OBJECT_STORAGE_ENDPOINT=__FROM_PLATFORM_CONFIG__
OBJECT_STORAGE_ACCESS_KEY=__FROM_SECRET__
OBJECT_STORAGE_SECRET_KEY=__FROM_SECRET__
CORE_BACKEND_URL=__FROM_SERVICE_DISCOVERY__
AI_INFERENCE_SERVICE_URL=__FROM_SERVICE_DISCOVERY__
RAG_SERVICE_URL=__FROM_SERVICE_DISCOVERY__
AGENT_ORCHESTRATOR_URL=__FROM_SERVICE_DISCOVERY__
REPORTING_SERVICE_URL=__FROM_SERVICE_DISCOVERY__
NOTIFICATION_SERVICE_URL=__FROM_SERVICE_DISCOVERY__
JWT_SIGNING_KEY_REF=__SECRET_MANAGER_REFERENCE__
JWT_SIGNING_SECRET=__FROM_SECRET__
JWT_ISSUER=__FROM_PLATFORM_CONFIG__
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
AI_PROVIDER_API_KEY_REF=__SECRET_MANAGER_REFERENCE__
