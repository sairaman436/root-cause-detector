<!--
Purpose: Root Maven aggregator for Java modules in the production monorepo.
Why it exists: Provides a single entry point for building Spring Boot backend modules and shared Java libraries.
Architecture fit: Supports the approved Spring Boot core backend and Java shared package without introducing business features.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.airural</groupId>
    <artifactId>ai-rural-root-cause-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>AI Rural Root Cause Platform</name>
    <description>Root Maven build for the enterprise AI Decision Intelligence Platform monorepo.</description>

    <modules>
        <module>services/core-backend</module>
        <module>packages/java-shared</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.2</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>

